{
  "name": "leonida-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:cleanup": "node scripts/cleanup-test-data.mjs",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "lhci": "lhci autorun",
    "qa:sample-tip": "node scripts/qa-sample-tip.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:icons": "node scripts/generate-icons.mts",
    "supabase": "node scripts/supabase.mjs",
    "db:link": "node scripts/supabase.mjs link --project-ref @dev --yes",
    "db:push": "node scripts/supabase.mjs db push --remote=@dev --yes",
    "db:seed": "node scripts/supabase.mjs db push --remote=@dev --include-seed --yes && node scripts/seed-admin.mjs",
    "db:types": "node scripts/supabase.mjs gen types typescript --remote=@dev --schema public --out src/types/database.ts",
    "ingest:wiki": "node scripts/ingest-wiki.ts",
    "seed:dev": "node scripts/seed-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@sentry/nextjs": "^11.16.0",
    "@serwist/turbopack": "9.5.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "serwist": "9.5.15",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0"
}

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Leonida Atlas"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Every host the site is served on (Twitch embeds need each one as a `parent`)
NEXT_PUBLIC_SITE_HOSTS=localhost,yourdomain.com,www.yourdomain.com
NEXT_PUBLIC_SHOW_IMPRESSUM=false
# true once you run ads/affiliate links: blocks non-commercial (NC) wiki sources from ingestion
SITE_COMMERCIAL=true
SEED_ADMIN_EMAIL=you@example.com
ADMIN_EMAIL=you@example.com

# ─── Supabase (DEV values locally; PROD values only in Vercel Production env) ───
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_REF.supabase.co
# Newer projects call these "publishable" and "secret" keys; older ones "anon" and "service_role"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=
# Personal access token for the Supabase CLI (supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=

# ─── AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Optional: for harder tasks or evals
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
# Best-vector-match cosine similarity needed before the model is called / an AI forum suggestion is posted
ASK_MIN_SCORE=0.45

# ─── Clips ───────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional override; otherwise resolved via /helix/games?name=Grand Theft Auto VI
TWITCH_GTA6_GAME_ID=
YOUTUBE_API_KEY=

# ─── Infra ───────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM="Leonida Atlas <hello@yourdomain.com>"
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Secrets you generate: openssl rand -hex 32 ─────────────────────────
CRON_SECRET=
ANON_HASH_SALT=

# ─── Wiki ingestion ──────────────────────────────────────────────────────
WIKI_CONTACT_EMAIL=you@example.com
WIKI_MAX_PAGES_PER_RUN=500

# ─── Optional ────────────────────────────────────────────────────────────
INDEXNOW_KEY=
